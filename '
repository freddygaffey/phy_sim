bool drawPoly(poly* polygon, float ran = 5, float thick = 2){
  vtx* c_vtx = polygon->origin;
  do{
    drawVtx(c_vtx);
    c_vtx = c_vtx->next;
    // DrawLine(c_vtx->x,c_vtx->y,c_vtx->next->x,c_vtx->next->y,BLUE);
  } while (c_vtx->next != polygon->origin);
  return true;
}


