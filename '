struct vtx {
  vtx* next;
  vtx* prev;
  int x;
  int y;
  int point_cnt;

  vtx(int _x, int _y, vtx* _prev = nullptr, vtx* _next = nullptr, int _point_cnt = 0){
    if(_prev != nullptr){
        assert(_next != _prev);
    }

    x = _x;
    y = _y;
    next = _next;
    prev = _prev;
    point_cnt = _point_cnt;
  };
};

class poly {
  public:
    vtx* origin;
    bool cw;
    double area;

  poly(int* point, int point_cnt){
    vtx* _origin = (vtx*) malloc(sizeof(vtx)*point_cnt);
    int x = *point;
    int y = *(point+1);

    vtx* next = _origin+1;
    vtx* prev = _origin+point_cnt;
    *_origin = vtx(x,y,next,prev,0);
    
    for(int i = 1; i<point_cnt; i++){
      x = *(point+(i*2));
      y = *(point+(i*2)+1);
      *(_origin+i) = vtx(x,y,_origin+(i-1),_origin+(i+1),i);
    }
    *(_origin+point_cnt) = vtx(x,y,_origin+(point_cnt-1),_origin,point_cnt);
    origin = _origin;
    assert(validate(_origin,true) != -1);
  }

  int validate(vtx* _origin,bool print = false){
    vtx* next = _origin;

    int i = 0;
    do{
      next = next->next;
      i++;

      if (print == true) {
        printf("%d,%d\n",next->x,next->y);
      }
    }while(i<MAX_EDGE_CNT || next == _origin);

    assert(i >= 3);
    return -1;
  };
};

